# ───────────────────────────────────────────────────────────────────────────
# HypeIndexVault — deploy + keeper config (ValueChain testnet, chainId 138565)
#
# USAGE:
#   cp contracts/deploy-vault.env.example contracts/.env.deploy
#   # fill in the blanks below (contracts/.env.deploy is gitignored — safe for keys)
#   ./contracts/deploy-vault.sh check     # validate env + RPC + deployer balance
#   ./contracts/deploy-vault.sh deploy    # build + deploy + write addresses back here
#   ./contracts/deploy-vault.sh open-vault <on_chain_index_id> <creator_address>
# ───────────────────────────────────────────────────────────────────────────

# ── Network ──
# Reachable ValueChain testnet RPC (chainId 138565). Public: https://testnet-rpc.valuechain.io
SSI_RPC_URL=https://testnet-rpc.valuechain.io

# ── Deploy (required) ──
# Deployer private key (hex). MUST hold VAL for gas. The deploy script signs with this.
DEPLOYER_PK=
# Role addresses:
VAULT_SIGNER=          # signs NAV price attestations (oracle)
VAULT_KEEPER=          # calls openVault / settleDeposit / settleRedeem / accrueMgmt
VAULT_GUARDIAN=        # emergency pause authority
# Optional: canonical USDC address. Leave EMPTY on testnet to auto-deploy MockUSDC.
USDC_ADDRESS=

# ── Filled automatically AFTER `deploy` (the script writes these for you) ──
NEXT_PUBLIC_HYPE_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# ── Keeper / NAV-signer service (agent-service/src/vault — run after deploy) ──
# Private keys for the SIGNER and KEEPER addresses above. Keeper needs VAL for gas.
VAULT_SIGNER_PRIVATE_KEY=
VAULT_KEEPER_PRIVATE_KEY=
VAULT_RPC_URL=https://testnet-rpc.valuechain.io
VAULT_CHAIN_ID=138565
VAULT_ADDRESS=          # = NEXT_PUBLIC_HYPE_VAULT_ADDRESS (filled by `deploy`)
VAULT_USDC_ADDRESS=     # = NEXT_PUBLIC_USDC_ADDRESS (filled by `deploy`)

# ── Earnings indexer (run_keeper.py daemon — fills pb_earnings) ──
# Service-role Supabase creds so the daemon can write pb_earnings/pb_subscriptions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Block the vault was deployed at (from the `deploy` output) — indexer start point.
VAULT_DEPLOY_BLOCK=0
VAULT_CONFIRMATIONS=2   # blocks behind head before ingesting events
VAULT_POLL_INTERVAL=30  # seconds between daemon ticks
# NOTE: the daemon auto-opens a vault for every published index (reconcile),
# so the manual `deploy-vault.sh open-vault` step is optional once it's running.
