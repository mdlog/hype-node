# ---- Frontend → Agent service ----
AGENT_SERVICE_URL=http://localhost:8001

# ---- SoSoValue OpenAPI v1 ----
# Get a key at https://sosovalue-1.gitbook.io/sosovalue-api-doc/setting-up-your-api-key
SOSOVALUE_API_KEY=
SOSOVALUE_API_BASE=https://openapi.sosovalue.com/openapi/v1
# Demo tier = 1 request/minute, total. The client enforces a 65s gap between
# outbound calls and caches successful responses for 15 minutes. Bump these on
# higher tiers (e.g. SOSOVALUE_MIN_GAP_MS=1000 for the unlimited plan).
# Defaults below are tuned for the High Frequency tier (100 req/min, 100k/mo).
# For Demo tier (1 req/min) use:
#   SOSOVALUE_MIN_GAP_MS=65000
#   SOSOVALUE_CACHE_TTL_MS=900000
#   SOSOVALUE_QUOTA_BACKOFF_MS=21600000
SOSOVALUE_MIN_GAP_MS=700
SOSOVALUE_CACHE_TTL_MS=60000
SOSOVALUE_QUOTA_BACKOFF_MS=1800000

# ---- SSI Protocol (ValueChain L1) ----
# RPC + on-chain registry contract
SSI_RPC_URL=https://rpc.valuechain.io
SSI_REGISTRY_ADDRESS=
# Hot key only for local agent runs. Production should sign in the wallet layer.
SSI_PRIVATE_KEY=

# ---- SoDEX REST v1 ----
# mainnet (chainId 286623) or testnet (chainId 138565)
SODEX_ENV=mainnet
SODEX_SPOT_BASE=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_PERPS_BASE=https://mainnet-gw.sodex.dev/api/v1/perps
# Read-only endpoints don't need auth. Trade actions are EIP-712 signed by your
# wallet — no static API key for SoDEX itself.

# ---- Anthropic (used by the Python agent for chat) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- LangGraph checkpoint store ----
LANGGRAPH_CHECKPOINT_DIR=./.checkpoints

# ---- SIWE auth (wallet sign-in) ----
# Iron-session cookie seal. Must be 32+ chars of high-entropy randomness in
# production — otherwise the session cookie is forgeable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_PASSWORD=
# WalletConnect Cloud project id (https://cloud.reown.com). Required for
# WalletConnect / mobile pairing. Browser-injected wallets work without it
# but RainbowKit will warn at boot.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
