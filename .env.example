# ---- Frontend → Agent service ----
AGENT_SERVICE_URL=http://localhost:8001

# ---- SoSoValue OpenAPI v1 ----
# Get a key at https://sosovalue-1.gitbook.io/sosovalue-api-doc/setting-up-your-api-key
SOSOVALUE_API_KEY=
SOSOVALUE_API_BASE=https://openapi.sosovalue.com/openapi/v1
# Demo tier = 1 request/minute, total. The client enforces a 65s gap between
# outbound calls and caches successful responses for 15 minutes. Bump these on
# higher tiers (e.g. SOSOVALUE_MIN_GAP_MS=1000 for the unlimited plan).
# Defaults below are tuned for the High Frequency tier (100 req/min, 100k/mo).
# For Demo tier (1 req/min) use:
#   SOSOVALUE_MIN_GAP_MS=65000
#   SOSOVALUE_CACHE_TTL_MS=900000
#   SOSOVALUE_QUOTA_BACKOFF_MS=21600000
SOSOVALUE_MIN_GAP_MS=700
SOSOVALUE_CACHE_TTL_MS=60000
SOSOVALUE_QUOTA_BACKOFF_MS=1800000

# ---- SSI Registry (HypeIndex on-chain registry) ----
# Default deploy target is Sepolia (chainId 11155111). Override SSI_CHAIN_ID +
# SSI_RPC_URL to deploy elsewhere (e.g. ValueChain L1: 286623).
SSI_CHAIN_ID=11155111
SSI_RPC_URL=
SSI_REGISTRY_ADDRESS=
# Hot key for server-side autonomous publishes (agent rebalance loop).
# UI publishes go through the user's connected wallet — this key is NOT used
# for the "Sign & Publish to SSI" button in the proposals UI.
SSI_PRIVATE_KEY=

# Public mirrors so PublishActions.tsx (browser) can target the right chain
# and contract. Must match SSI_CHAIN_ID / SSI_REGISTRY_ADDRESS above.
NEXT_PUBLIC_SSI_CHAIN_ID=11155111
NEXT_PUBLIC_SSI_REGISTRY_ADDRESS=

# ---- SoDEX REST v1 ----
# mainnet (chainId 286623) or testnet (chainId 138565)
SODEX_ENV=testnet
SODEX_SPOT_BASE=https://testnet-gw.sodex.dev/api/v1/spot
SODEX_PERPS_BASE=https://testnet-gw.sodex.dev/api/v1/perps
# Read-only endpoints don't need auth. Trade actions are EIP-712 signed.
#
# Quickstart (master-wallet auth — recommended for testing):
#   SODEX_PRIVATE_KEY  = your wallet's hex private key (no 0x is fine)
#   SODEX_API_KEY_NAME = leave empty
# The server recovers the signer from the signature alone — no API key
# registration required. This matches the Go SDK's default behavior.
#
# Production / multi-signer setup:
#   Register a delegated API key (separate from master) via the AddAPIKey
#   action signed by the master wallet, then set both vars.
SODEX_PRIVATE_KEY=
SODEX_API_KEY_NAME=

# ---- LLM config lives in agent-service/.env (NOT here) ----
# The chat/strategy agents run in the Python agent-service, which loads its own
# agent-service/.env (see agent-service/.env.example for LLM_PROVIDER + keys).
# The Next.js app never calls an LLM directly — it proxies /chat to
# AGENT_SERVICE_URL, and the billing meter prices each turn by the model the
# agent reports back (usage.model). No LLM keys are needed in this file.

# ---- LangGraph checkpoint store ----
LANGGRAPH_CHECKPOINT_DIR=./.checkpoints

# ---- SIWE auth (wallet sign-in) ----
# Iron-session cookie seal. REQUIRED in production: must be 32+ chars of
# high-entropy randomness and NOT the dev fallback — the app hard-fails at
# runtime (NODE_ENV=production) if this is missing or left at the public
# default, because otherwise the session cookie is forgeable. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_PASSWORD=

# ---- Agent operations (control + cost routes) ----
# Comma-separated, lowercased wallet addresses allowed to drive the SHARED
# autonomous agent: /api/agent/{halt,pause,reset,step} and /api/agent/risk-config.
# In production these routes FAIL CLOSED until this is set (no operators =
# agent control disabled). Outside production, any signed-in wallet may operate.
#   AGENT_OPERATORS=0xabc...,0xdef...
AGENT_OPERATORS=

# Shared secret for the settlement keeper / on-chain indexer to write the
# earnings ledger server-to-server (POST /api/publisher/earnings via the
# `x-keeper-secret` header). Leave blank to disable the keeper write path;
# when blank, only authenticated operators can write earnings. Ordinary
# creators can NEVER write their own earnings.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEEPER_SECRET=

# ---- Privy (login UI: email / Google / Twitter / wallet) ----
# Get an app id at https://dashboard.privy.io. The free tier covers up to
# 1,000 monthly active users; both embedded wallets (auto-created for
# email/social logins) and external wallets bridge into wagmi via
# @privy-io/wagmi, so the rest of the app keeps using `useAccount`,
# `useSignMessage`, `useWriteContract` unchanged.
NEXT_PUBLIC_PRIVY_APP_ID=

# (Legacy) WalletConnect Cloud project id. No longer required after the
# Privy migration — Privy handles WalletConnect pairing internally — but
# kept here for reference if you ever revert to RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Wave-2 vault (fill after deploy) ----
# After deploying HypeIndexVault + MockUSDC (see contracts/DEPLOY-VAULT.md),
# paste the deployed addresses here and redeploy the frontend.
# Until these are set, /discover/<id> shows an honest "Vault not deployed yet"
# fallback instead of a broken button.
NEXT_PUBLIC_HYPE_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
