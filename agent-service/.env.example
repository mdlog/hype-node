# LLM provider for the chat + strategy agents. "anthropic" or "openai"
# (defaults to anthropic). "openai" also drives any OpenAI-compatible API —
# see the Qwen block below.
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI-compatible provider (used when LLM_PROVIDER=openai).
# Works with real OpenAI OR any OpenAI-compatible endpoint via OPENAI_BASE_URL.
# Recommended OpenAI model: gpt-4o.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
#
# --- Alibaba Qwen (DashScope) ---------------------------------------------
# Qwen is reachable through DashScope's OpenAI-compatible mode. To run the
# agents on Qwen: set LLM_PROVIDER=openai above and uncomment the lines below.
# NOTE: keep OPENAI_BASE_URL commented out (not blank) for real OpenAI — the
# SDK treats an empty OPENAI_BASE_URL as a literal, broken base URL.
#   OPENAI_API_KEY=<your DashScope API key>
#   OPENAI_MODEL=qwen-max          # or qwen3-max / qwen-plus — must support tool calling
#   OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # international
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1        # China (Beijing)

# SoSoValue OpenAPI v1 — defaults for High Frequency tier (100/min, 100k/mo).
# For Demo tier set MIN_GAP_SEC=65, CACHE_TTL_SEC=900, QUOTA_BACKOFF_SEC=21600.
SOSOVALUE_API_KEY=
SOSOVALUE_API_BASE=https://openapi.sosovalue.com/openapi/v1
SOSOVALUE_MIN_GAP_SEC=0.7
SOSOVALUE_CACHE_TTL_SEC=60
SOSOVALUE_QUOTA_BACKOFF_SEC=1800

# Agent loop cadence. 30s for paid tier, 120s for Demo.
AGENT_LOOP_SEC=30

# SSI Protocol (ValueChain L1)
SSI_RPC_URL=https://rpc.valuechain.io

# SoDEX REST v1 — mainnet 286623 / testnet 138565
SODEX_ENV=mainnet
SODEX_SPOT_BASE=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_PERPS_BASE=https://mainnet-gw.sodex.dev/api/v1/perps

PORT=8001
LANGGRAPH_CHECKPOINT_DIR=./.checkpoints

# --- Hype-Radar auto-draft (UNIT D) -----------------------------------------
# When enabled, the agent loop automatically creates a "hype_radar" draft
# proposal in pb_proposals whenever a sector's sentiment score exceeds
# DRAFT_THRESHOLD.  Off by default — set to "true" to activate.
#
# AGENT_AUTODRAFT_ENABLED — master switch; default OFF (empty = off).
AGENT_AUTODRAFT_ENABLED=
#
# DRAFT_THRESHOLD — minimum sentiment score (0-100) required to trigger a
# draft.  Default 60.  Increase to raise the bar (e.g. 75 for high-conviction
# only); set lower only in testing.
DRAFT_THRESHOLD=60
#
# AGENT_CREATOR_ADDRESS — on-chain address recorded as the proposal creator.
# Must be set (and Supabase vars must be set) for drafts to be written.
# Without this the auto-draft is a silent no-op even when enabled.
AGENT_CREATOR_ADDRESS=
