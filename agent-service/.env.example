# LLM provider for the chat agent. "anthropic" or "openai" (defaults to anthropic).
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (used when LLM_PROVIDER=openai). Recommended model: gpt-4o.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SoSoValue OpenAPI v1 — defaults for High Frequency tier (100/min, 100k/mo).
# For Demo tier set MIN_GAP_SEC=65, CACHE_TTL_SEC=900, QUOTA_BACKOFF_SEC=21600.
SOSOVALUE_API_KEY=
SOSOVALUE_API_BASE=https://openapi.sosovalue.com/openapi/v1
SOSOVALUE_MIN_GAP_SEC=0.7
SOSOVALUE_CACHE_TTL_SEC=60
SOSOVALUE_QUOTA_BACKOFF_SEC=1800

# Agent loop cadence. 30s for paid tier, 120s for Demo.
AGENT_LOOP_SEC=30

# SSI Protocol (ValueChain L1)
SSI_RPC_URL=https://rpc.valuechain.io

# SoDEX REST v1 — mainnet 286623 / testnet 138565
SODEX_ENV=mainnet
SODEX_SPOT_BASE=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_PERPS_BASE=https://mainnet-gw.sodex.dev/api/v1/perps

PORT=8001
LANGGRAPH_CHECKPOINT_DIR=./.checkpoints
